# Nyaya Sakhi — frontend environment
# Copy this file to .env and fill in the values. Never commit .env.

# Lovable Cloud / Supabase (provided by Lovable when Cloud is connected)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# FastAPI backend base URL (no trailing slash), e.g. http://localhost:8000
# If unset, the app shows a clear "Backend not configured" state instead of
# calling the backend. There are no mock/fallback responses.
VITE_API_BASE_URL=http://localhost:8000
