# Nyaya Sakhi backend — copy to .env and fill in. Never commit .env.

# --- Database (Supabase / Lovable Cloud Postgres) --------------------------
# Use the "Connection string" (URI) shown in your database settings, e.g.
# postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/postgres

# --- Supabase authentication ----------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Publishable (anon) key — used for JWKS discovery fallback headers
SUPABASE_PUBLISHABLE_KEY=
# JWT verification: EITHER paste the JWT secret (legacy HS256 projects) OR
# leave empty to verify with the project's JWKS (asymmetric keys, recommended).
SUPABASE_JWT_SECRET=

# --- LLM (provider-agnostic OpenAI-compatible chat completions) ------------
LLM_BASE_URL=https://api.openai-compatible-provider.example/v1
LLM_API_KEY=
LLM_MODEL=

# --- Embeddings ------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIM=768
SIMILARITY_THRESHOLD=0.35
SCOPE_THRESHOLD=0.5

# --- Translation (optional) -------------------------------------------------
# none | libretranslate | llm
TRANSLATION_PROVIDER=none
# TRANSLATION_PROVIDER=libretranslate
# LIBRETRANSLATE_URL=http://localhost:5000

# --- Speech (optional) ------------------------------------------------------
# When unset, /api/speech/* returns 501 with setup instructions.
STT_PROVIDER=
STT_API_KEY=
STT_BASE_URL=
TTS_PROVIDER=
TTS_API_KEY=
TTS_BASE_URL=

# --- Files ------------------------------------------------------------------
UPLOAD_DIR=./data/uploads

# --- App --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8080,http://localhost:4173
LOG_LEVEL=INFO
